# Copy this file to ".env" and fill in your own values.
# The real .env file is listed in .gitignore and must never be committed.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Gemini model used for health remarks.
# Run "python scripts/check_setup.py --api" to list the models your key can use.
GEMINI_MODEL=

# Seconds to wait for the AI service before giving up.
AI_TIMEOUT_SECONDS=20

# Location of the SQLite database file (created automatically).
DATABASE_PATH=data/patients.db
